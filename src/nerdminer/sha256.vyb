    res.push(r7)
    return res
}

# SHA-256 of a byte buffer (FIPS 180-4 padding). Returns the 32-byte digest.
share(all)
sha256(data<their<Vec<Int> const>>)<Vec<Int>> -> {
    n<Int> = data.len()
    msg<Vec<Int>> = Vec()
    for (i in 0..n-1) { msg.push(data.get(i)) }
    msg.push(0x80)
    while ((msg.len() % 64) != 56) { msg.push(0) }
    bits<Int> = n * 8
    for (k in 0..7) { msg.push((bits >> ((7 - k) * 8)) & 0xff) }
    st<Vec<UInt32>> = sha256_iv()
    blocks<Int> = msg.len() / 64
    for (bi in 0..blocks-1) {
        blk<Vec<UInt32>> = Vec()
        for (j in 0..15) { blk.push(be_word(view(msg), bi * 64 + j * 4)) }
        st = sha256_compress(view(st), view(blk))
    }
    digest<Vec<Int>> = Vec()
    for (j in 0..7) { push_be_word(borrow(digest), st[j]) }
    return digest
}

# Double SHA-256 (Bitcoin's hash256). Upstream: two mbedtls_sha256 passes.
share(all)
sha256d(data<their<Vec<Int> const>>)<Vec<Int>> -> {
    first<Vec<Int>> = sha256(data)
    return sha256(view(first))
}

# Midstate: compress the first 64 bytes of the 80-byte block header once per
# job (upstream nerd_mids). Only the last 16 bytes change per nonce.
share(all)
nerd_mids(header<their<Vec<Int> const>>)<Vec<UInt32>> -> {
    blk<Vec<UInt32>> = Vec()
    for (j in 0..15) { blk.push(be_word(header, j * 4)) }
    iv<Vec<UInt32>> = sha256_iv()
    return sha256_compress(view(iv), view(blk))
}

