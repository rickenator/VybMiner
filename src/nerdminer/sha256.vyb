# sha256.vyb -- SHA-256 / double-SHA-256 for the NerdMiner reconstruction.
#
# GENERATED by tools/gen_sha256.py -- edit the generator, not this file.
#
# Upstream mapping (NerdMiner_V2 Release-1.6.3, src/ShaTests/nerdSHA256plus.cpp):
#   nerd_mids(&ctx, header)          -> nerd_mids(header)      (midstate, 8 words)
#   nerd_sha256d(&ctx, header+64, h) -> nerd_sha256d_h7(...)   (hot path, top word only)
#                                       nerd_sha256d(...)      (full 32-byte digest)
# plus a general byte-oriented sha256()/sha256d() used for the coinbase and
# merkle-branch hashing that upstream does with mbedtls_sha256 in utils.cpp.
#
# Words are UInt32 so additions wrap mod 2^32 exactly as in C. Bytes travel as
# Vec<Int> holding 0..255 (Vec<UInt8> element stores currently warn/sign-extend
# in this Vyb build -- see README "Vyb gaps").

# --- the six FIPS 180-4 logical functions ---------------------------------
# Reference forms. The generated rounds below expand these inline (see the
# generator: per-call runtime frame push/pop makes small helpers expensive).

rotr(x<UInt32>, n<UInt32>)<UInt32> -> {
    return (x >> n) | (x << ((32 as UInt32) - n))
}

ch(x<UInt32>, y<UInt32>, z<UInt32>)<UInt32> -> {
    return (x & y) ^ (~x & z)
}

maj(x<UInt32>, y<UInt32>, z<UInt32>)<UInt32> -> {
    return (x & y) ^ (x & z) ^ (y & z)
}

bsig0(x<UInt32>)<UInt32> -> {
    return rotr(x, 2 as UInt32) ^ rotr(x, 13 as UInt32) ^ rotr(x, 22 as UInt32)
}

bsig1(x<UInt32>)<UInt32> -> {
    return rotr(x, 6 as UInt32) ^ rotr(x, 11 as UInt32) ^ rotr(x, 25 as UInt32)
}

ssig0(x<UInt32>)<UInt32> -> {
    return rotr(x, 7 as UInt32) ^ rotr(x, 18 as UInt32) ^ (x >> (3 as UInt32))
}

ssig1(x<UInt32>)<UInt32> -> {
    return rotr(x, 17 as UInt32) ^ rotr(x, 19 as UInt32) ^ (x >> (10 as UInt32))
}

# Byte-swap a 32-bit word (upstream: swab32 / bswap_32 in utils.cpp).
share(all)
bswap32(v<UInt32>)<UInt32> -> {
    return ((v & (0xff as UInt32)) << (24 as UInt32)) | ((v & (0xff00 as UInt32)) << (8 as UInt32)) |
           ((v >> (8 as UInt32)) & (0xff00 as UInt32)) | (v >> (24 as UInt32))
}

# Big-endian word from bytes[off..off+3] (bytes are 0..255 Ints).
share(all)
be_word(bytes<their<Vec<Int> const>>, off<Int>)<UInt32> -> {
    return (((bytes.get(off) as UInt32) << (24 as UInt32)) | ((bytes.get(off + 1) as UInt32) << (16 as UInt32)) |
            ((bytes.get(off + 2) as UInt32) << (8 as UInt32)) | (bytes.get(off + 3) as UInt32))
}

# Append the 4 big-endian bytes of `w` to `out`.
share(all)
push_be_word(out<their<Vec<Int>>>, w<UInt32>)<Int> -> {
    out.push(((w >> (24 as UInt32)) & (0xff as UInt32)) as Int)
    out.push(((w >> (16 as UInt32)) & (0xff as UInt32)) as Int)
    out.push(((w >> (8 as UInt32)) & (0xff as UInt32)) as Int)
    out.push((w & (0xff as UInt32)) as Int)
    return 4
}

# SHA-256 initial hash value H(0).
share(all)
sha256_iv()<Vec<UInt32>> -> {
    iv<Vec<UInt32>> = Vec()

    iv.push((0x6a09e667 as UInt32))
    iv.push((0xbb67ae85 as UInt32))
    iv.push((0x3c6ef372 as UInt32))
    iv.push((0xa54ff53a as UInt32))
    iv.push((0x510e527f as UInt32))
    iv.push((0x9b05688c as UInt32))
    iv.push((0x1f83d9ab as UInt32))
    iv.push((0x5be0cd19 as UInt32))
    return iv
}

